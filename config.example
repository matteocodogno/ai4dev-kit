# Copy to ~/.config/ai4dev/config, then:   chmod 600 ~/.config/ai4dev/config
#
# This file is sourced by the shell and it holds your virtual key, so its
# permissions matter. 'ai4dev doctor' checks them and complains if they are wrong.

# Your personal virtual key.
#
# LEAVE THIS EMPTY UNTIL DAY 1. The key is issued in the room and arrives as a
# Slack DM; paste it here then. Before that, 'ai4dev doctor' will show this line
# in yellow and still finish green as "ready for day 1" — that is correct, and
# there is nothing to fix.
#
# Never share it, never commit it, never paste it into a channel.
AI4DEV_API_KEY=""

AI4DEV_GATEWAY_URL="https://aiproxy.ai4dev.dev/v1"
AI4DEV_DASHBOARD_URL="https://langfuse.ai4dev.dev"

# Where 'ai4dev init' clones the course repositories.
AI4DEV_WORKSPACE="$HOME/ai4dev"

# Where the course repositories live.
AI4DEV_GIT_BASE="git@github.com:matteocodogno"

# The tag the product repository starts from. Changes every module.
AI4DEV_START_TAG="module-01-start"

# Which gateway alias OpenCode starts on. Leave it out and you get the course
# default. Anything you set here survives `ai4dev code`, which refreshes the
# model list on every run but never argues with this line.
#
# AI4DEV_OPENCODE_MODEL="frontier"
