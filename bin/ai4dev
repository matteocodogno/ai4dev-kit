#!/usr/bin/env bash
#
# ai4dev — the AI4Dev course CLI
#
# This script lives in YOUR kit. It is true of you, not of any codebase, and it
# follows you into every repository you work in. No AI command is ever defined
# inside a product repository.
#
#   ai4dev init            clone the course repositories into ~/ai4dev
#   ai4dev doctor          verify everything; with a key, make one real request
#                          (before day 1 there is no key yet — that is expected,
#                           and doctor reports "ready for day 1" instead of red)
#   ai4dev ask <prompt>    ask a model alias directly — the raw loop, no prompt
#                          template in the way. --model, --temp, --n, --prompt-file
#   ai4dev code            start OpenCode against the course gateway, with your
#                          key borrowed for the life of one process
#   ai4dev review <file>   review a file with YOUR review prompt, from this kit
#   ai4dev commit          write a commit message from the staged diff
#   ai4dev costs           your spend, your remaining budget, where your traces are
#   ai4dev costs --last N  the last N requests: tokens, cost, latency, which model
#   ai4dev key             check that your virtual key is present and usable
#   ai4dev config          show the resolved configuration
#   ai4dev module N start  put the repository at the start of module N
#   ai4dev module N end    show how module N was solved
#   ai4dev upgrade         update the tool from the course, leaving your work alone
#
# Config resolution: environment > ~/.config/ai4dev/config > defaults.
# Your virtual key lives in that config file, which must be mode 600. This
# script never prints it in full and never copies it anywhere.

set -euo pipefail

readonly AI4DEV_VERSION="1.12.1"

# The parts of this kit the COURSE owns and may replace. Everything else in
# here is yours: your prompts once you have edited them, your checklists, your
# decisions, your notes. 'ai4dev upgrade' updates this list and nothing else.
readonly COURSE_OWNED=(bin README.md config.example)
readonly CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/ai4dev/config"

# OpenCode reads its global config from this exact path. It does not honour
# XDG_CONFIG_HOME, so neither do we here: a path we invent is a path OpenCode
# will not read.
readonly OPENCODE_CONFIG_FILE="$HOME/.config/opencode/opencode.json"

# The kit is this script's own repository: bin/ai4dev -> repo root.
KIT_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")/.." && pwd)"

# ─── output ──────────────────────────────────────────────────────────────────

if [[ -t 1 ]]; then
  R=$'\033[31m'; G=$'\033[32m'; Y=$'\033[33m'; B=$'\033[34m'; D=$'\033[2m'; N=$'\033[0m'
else
  R=""; G=""; Y=""; B=""; D=""; N=""
fi

ok()   { printf '%s✓%s %s\n' "$G" "$N" "$1"; }
bad()  { printf '%s✗%s %s\n' "$R" "$N" "$1"; [[ -n "${2:-}" ]] && printf '  %s→ %s%s\n' "$D" "$2" "$N"; FAILED=1; }
warn() { printf '%s!%s %s\n' "$Y" "$N" "$1"; }
info() { printf '%s%s%s\n' "$D" "$1" "$N"; }
die()  { printf '%serror:%s %s\n' "$R" "$N" "$1" >&2; exit 1; }

# ─── config ──────────────────────────────────────────────────────────────────

load_config() {
  # A value already exported in the environment wins over the config file. The
  # file is the normal source; the environment is how you try a second key or a
  # second gateway without editing it. Without this, `source` clobbers both, and
  # the empty AI4DEV_API_KEY= line every participant has during priming would
  # silently override a key you just exported — which looks exactly like a
  # broken key and is not.
  local env_key="${AI4DEV_API_KEY:-}" env_gateway="${AI4DEV_GATEWAY_URL:-}"

  # shellcheck disable=SC1090
  [[ -f "$CONFIG_FILE" ]] && source "$CONFIG_FILE"

  if [[ -n "$env_key" ]];     then AI4DEV_API_KEY="$env_key"; fi
  if [[ -n "$env_gateway" ]]; then AI4DEV_GATEWAY_URL="$env_gateway"; fi

  AI4DEV_KIT="${AI4DEV_KIT:-$KIT_ROOT}"
  AI4DEV_WORKSPACE="${AI4DEV_WORKSPACE:-$HOME/ai4dev}"
  AI4DEV_GATEWAY_URL="${AI4DEV_GATEWAY_URL:-}"
  AI4DEV_DASHBOARD_URL="${AI4DEV_DASHBOARD_URL:-}"
  AI4DEV_GIT_BASE="${AI4DEV_GIT_BASE:-git@github.com:matteocodogno}"
  AI4DEV_START_TAG="${AI4DEV_START_TAG:-module-01-start}"
  AI4DEV_OPENCODE_MODEL="${AI4DEV_OPENCODE_MODEL:-open-hosted}"
}

require_gateway() {
  [[ -n "$AI4DEV_GATEWAY_URL" ]] || die "AI4DEV_GATEWAY_URL is not set. See $CONFIG_FILE"
}

# ─── the virtual key ─────────────────────────────────────────────────────────
#
# It arrives by Slack DM and you paste it into the config file. That is a
# deliberate choice, not a shortcut: this key is capped at a fixed budget, lives
# only as long as the course, and is revoked with one call. A credential whose
# blast radius is bounded does not need the ceremony a production key needs.
#
# That reasoning is the lesson. Apply it to your own provider keys and check
# whether it still holds. Usually it does not, and that is the point.
#
# It is a gateway-issued virtual key, not a provider key: it carries your
# identity and your budget, and it cannot reach a provider directly.

fetch_key() {
  [[ -n "${AI4DEV_API_KEY:-}" ]] || return 1
  printf '%s' "$AI4DEV_API_KEY"
}

# The config file holds the key, so its permissions are part of the environment.
config_mode() {
  [[ -f "$CONFIG_FILE" ]] || { printf 'missing'; return; }
  # BSD and GNU stat disagree on -f: on macOS it is the file's mode, on Linux it
  # is filesystem status, which succeeds and prints several lines of nonsense.
  # So try GNU first and validate the shape either way.
  local m
  m="$(stat -c '%a' "$CONFIG_FILE" 2>/dev/null)" || m=""
  [[ "$m" =~ ^[0-7]{3,4}$ ]] || m="$(stat -f '%Lp' "$CONFIG_FILE" 2>/dev/null)" || m=""
  [[ "$m" =~ ^[0-7]{3,4}$ ]] || m="unknown"
  printf '%s' "$m"
}

# participant: the name every request is attributed to.
#
# It comes from your git identity, which 'ai4dev doctor' insists you configure
# with your real name. The same name signs your commits and your AI requests,
# which is the point: one identity, two ledgers.
participant() {
  local n
  n="$(git config --global user.name 2>/dev/null || true)"
  [[ -n "$n" ]] || n="${USER:-unknown}"
  printf '%s' "$n"
}

# ─── gateway call ────────────────────────────────────────────────────────────
#
# call <role> <prompt> [k=v,k=v]
# The role is a named alias configured on the gateway (reviewer, committer,
# architect, tester). You never name a model here: which model answers is an
# infrastructure decision made by somebody else, and that is the point.

# ─── the ledger ──────────────────────────────────────────────────────────────
#
# Every request this CLI makes is appended here, one JSON object per line.
#
# There are now three records of the same request, and they do not say the same
# thing. The gateway knows what it charged you. The dashboard knows what was
# sent and what came back. This file knows how long *you* waited, which neither
# of the other two can see, because latency is a property of where you are
# standing. 'ai4dev costs --last' reads this one.
#
# It is yours, it is local, and deleting it loses nothing the gateway has.
readonly LEDGER="${XDG_STATE_HOME:-$HOME/.local/state}/ai4dev/usage.jsonl"

# Set by call() while it runs, and used by it to write the ledger line. They do
# NOT survive back to the caller: call() is invoked in a command substitution,
# which is a subshell, and a subshell cannot assign to its parent's variables.
# Anything that wants the last call's numbers reads the ledger, which is a file
# and therefore does survive. That is what last_call_footer does.
LAST_ALIAS=""; LAST_MODEL=""; LAST_IN=0; LAST_OUT=0; LAST_COST=0; LAST_LATENCY=0

# ─── when the gateway is not the one answering ───────────────────────────────
#
# The gateway returns JSON even for its own errors. So a body that is not JSON
# means something else answered: in practice a VPN or a corporate proxy that
# intercepted the request and replied with its own HTML page. Left alone, that
# reaches the participant as "jq: parse error: Invalid numeric literal at line
# 1, column 10", which is jq choking on the first ten characters of <!DOCTYPE.
# Nobody can act on that. Say what actually happened instead.

url_host() { local h="${1#*://}"; printf '%s' "${h%%/*}"; }

# not_json_reason <body_file> [content_type]
# Succeeds and prints a description when the body is NOT JSON; fails when it is.
not_json_reason() {
  local body="$1" ctype="${2:-}"
  jq empty "$body" >/dev/null 2>&1 && [[ -s "$body" ]] && return 1
  if [[ "$ctype" == *html* ]] || head -c 300 "$body" | grep -qiE '<!doctype|<html'; then
    printf 'an HTML page, not JSON'
  elif [[ ! -s "$body" ]]; then
    printf 'an empty response'
  else
    printf 'something that is not JSON ("%s")' "$(head -c 60 "$body" | tr -d '\r\n')"
  fi
}

# gateway_not_json_die <url> <http_code> <reason>
gateway_not_json_die() {
  printf '%serror:%s %s answered with %s (HTTP %s).\n\n' "$R" "$N" "$1" "$3" "${2:-?}" >&2
  printf '  The gateway answers in JSON even when it refuses you, so this is almost\n' >&2
  printf '  certainly not the gateway. Usually a VPN or a corporate proxy intercepted\n' >&2
  printf '  the request and replied with its own page.\n\n' >&2
  printf '  Disconnect the VPN and try again, or ask for %s to be allow-listed.\n' "$(url_host "$1")" >&2
  printf '  If you are on no VPN, check AI4DEV_GATEWAY_URL in %s.\n' "$CONFIG_FILE" >&2
  exit 1
}

header_value() {
  # header_value <file> <header-name>
  # Case-insensitive, tolerates the CR, prints nothing when the header is absent.
  tr -d '\r' < "$1" | awk -v want="$2" '
    { i = index($0, ":")
      if (i == 0) next
      if (tolower(substr($0, 1, i - 1)) == tolower(want)) {
        v = substr($0, i + 1); sub(/^ +/, "", v); print v
      } }' | tail -1
}

ledger_append() {
  mkdir -p "$(dirname "$LEDGER")"
  jq -n -c \
    --arg when     "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg alias    "$LAST_ALIAS" \
    --arg model    "$LAST_MODEL" \
    --arg temp     "${1:-}" \
    --argjson tin  "$LAST_IN" \
    --argjson tout "$LAST_OUT" \
    --argjson cost "$LAST_COST" \
    --argjson lat  "$LAST_LATENCY" \
    '{when: $when, alias: $alias, model: $model,
      temperature: (if $temp == "" then null else ($temp|tonumber) end),
      tokens_in: $tin, tokens_out: $tout, cost: $cost, latency_s: $lat}' \
    >> "$LEDGER"
}

call() {
  local role="$1" prompt="$2" meta="${3:-}" temp="${4:-}"
  require_gateway

  local key; key="$(fetch_key)" || die "no virtual key configured. Paste the one from your Slack DM into $CONFIG_FILE, then run 'ai4dev doctor'."

  local meta_json='{}'
  if [[ -n "$meta" ]]; then
    meta_json="$(printf '%s' "$meta" | jq -R 'split(",") | map(split("=") | {(.[0]): .[1]}) | add')"
  fi

  # Two of these keys are not decoration. The gateway forwards request metadata
  # to the observability backend, which reads exactly two names:
  #
  #   trace_user_id  -> who this request belongs to. Without it every trace is
  #                     attributed to "n/a" and the cohort dashboard is a single
  #                     anonymous bar.
  #   trace_name     -> what the request was for. Without it the dashboard ranks
  #                     HTTP routes instead of work.
  #
  # Renaming either one silently breaks attribution while everything still
  # appears to work. That is the whole lesson, and it is one line of JSON.
  local task; task="$(printf '%s' "$meta_json" | jq -r '.task // empty')"
  [[ -n "$task" ]] || task="$role"

  meta_json="$(jq -n --argjson m "$meta_json" \
                     --arg who "$(participant)" \
                     --arg name "ai4dev $task" \
                     '$m + {trace_user_id: $who, trace_name: $name, source: "ai4dev-cli"}')"

  local payload
  # temperature is sent ONLY when you asked for it. A CLI that always sends a
  # "safe" default is the liability Module 2 Part 1 describes: it works until
  # the alias is repointed at a reasoning model, and then it is a hard 400 on a
  # call whose code never changed.
  payload="$(jq -n --arg model "$role" --arg content "$prompt" --argjson metadata "$meta_json" \
    '{model: $model, messages: [{role: "user", content: $content}], metadata: $metadata}')"
  if [[ -n "$temp" ]]; then
    payload="$(printf '%s' "$payload" | jq --argjson t "$temp" '. + {temperature: $t}')"
  fi

  local body_file hdr_file
  body_file="$(mktemp)"; hdr_file="$(mktemp)"
  trap 'rm -f "$body_file" "$hdr_file"' RETURN

  local meta_out http_code
  meta_out="$(curl -sS -o "$body_file" -D "$hdr_file" -w '%{http_code} %{time_total} %{content_type}' \
    -X POST "$AI4DEV_GATEWAY_URL/chat/completions" \
    -H "Authorization: Bearer $key" \
    -H "Content-Type: application/json" \
    -d "$payload")" || die "could not reach the gateway. Run 'ai4dev doctor'."

  local ctype reason
  read -r http_code LAST_LATENCY ctype <<< "$meta_out"

  if reason="$(not_json_reason "$body_file" "$ctype")"; then
    gateway_not_json_die "$AI4DEV_GATEWAY_URL/chat/completions" "$http_code" "$reason"
  fi

  local response; response="$(cat "$body_file")"

  if [[ "$http_code" != "200" ]] || printf '%s' "$response" | jq -e '.error' >/dev/null 2>&1; then
    local msg; msg="$(printf '%s' "$response" | jq -r '.error.message // .error // .' 2>/dev/null || printf '%s' "$response")"

    # One error deserves a real explanation rather than a stack trace, because
    # it is a lesson and not a bug.
    if [[ -n "$temp" && "$msg" == *emperature* ]]; then
      printf '%serror:%s the alias %s'"'"'%s'"'"'%s does not accept temperature=%s.\n\n' "$R" "$N" "$B" "$role" "$N" "$temp" >&2
      printf '  Reasoning models take only their default temperature. Sending one is\n' >&2
      printf '  rejected outright, and nothing about your request was wrong yesterday.\n\n' >&2
      printf '  This is not something to work around by making the CLI drop the\n' >&2
      printf '  parameter quietly: that would hide the fact that your setting was\n' >&2
      printf '  never honoured. Run it without --temp, or against another alias.\n' >&2
      exit 1
    fi
    die "$msg"
  fi

  LAST_ALIAS="$role"
  LAST_MODEL="$(header_value "$hdr_file" x-litellm-model-name)"
  [[ -n "$LAST_MODEL" ]] || LAST_MODEL="$(printf '%s' "$response" | jq -r '.model // "unknown"')"
  LAST_IN="$( printf '%s' "$response" | jq -r '.usage.prompt_tokens     // 0')"
  LAST_OUT="$(printf '%s' "$response" | jq -r '.usage.completion_tokens // 0')"
  LAST_COST="$(header_value "$hdr_file" x-litellm-response-cost)"
  [[ "$LAST_COST" =~ ^[0-9.eE+-]+$ ]] || LAST_COST=0

  ledger_append "$temp"

  printf '%s' "$response" | jq -r '.choices[0].message.content'
}

last_call_footer() {
  [[ -f "$LEDGER" ]] || return 0
  local line
  line="$(tail -n 1 "$LEDGER" | jq -r '"\(.tokens_in) in · \(.tokens_out) out · $\(.cost) · \(.latency_s)s · \(.model)"')"
  printf '%s  %s%s\n' "$D" "$line" "$N"
}

last_call_cost() {
  [[ -f "$LEDGER" ]] || { printf '0'; return 0; }
  tail -n 1 "$LEDGER" | jq -r '.cost // 0'
}

render() {
  # render <template> <placeholder> <value> [<placeholder> <value> ...]
  local out; out="$(cat "$1")"; shift
  while [[ $# -gt 1 ]]; do
    out="${out//\[\[$1\]\]/$2}"
    shift 2
  done
  printf '%s' "$out"
}

# ─── commands ────────────────────────────────────────────────────────────────

# git@github.com:owner  ->  https://github.com/owner
#
# Corporate networks block outbound 22 far more often than they block 443, and
# it is never the participant's fault and never fixable from the room. So the
# SSH remote stays the default and HTTPS is the automatic second try: nobody
# has to know this happened, and nobody has to edit a config file while
# fifteen people wait.
https_base() {
  local b="${1:-}" rest
  case "$b" in
    git@*:*)   rest="${b#git@}"; printf 'https://%s/%s' "${rest%%:*}" "${rest#*:}" ;;
    ssh://git@*) rest="${b#ssh://git@}"; printf 'https://%s' "${rest/://}" ;;
    *)         printf '%s' "$b" ;;
  esac
}

# clone_repo <repo> <dest> — try the configured remote, then HTTPS.
clone_repo() {
  local repo="$1" dest="$2" primary fallback err
  primary="$AI4DEV_GIT_BASE/$repo.git"
  fallback="$(https_base "$AI4DEV_GIT_BASE")/$repo.git"

  if err="$(git clone --quiet "$primary" "$dest" 2>&1)"; then
    ok "$repo cloned"
    return 0
  fi

  # A blocked port 22 surfaces as half a dozen different messages depending on
  # the firewall, so do not try to classify the failure. If an HTTPS form of the
  # same remote exists, just try it. A second clone costs seconds.
  if [[ "$fallback" != "$primary" ]]; then
    discard_partial_clone "$dest"
    warn "$repo: the ssh remote did not work, trying https"
    if git clone --quiet "$fallback" "$dest" 2>/dev/null; then
      ok "$repo cloned over https"
      return 0
    fi
  fi

  discard_partial_clone "$dest"
  bad "could not clone $repo" "show this line to the facilitator"
  printf '%s\n' "$err" | sed 's/^/    /' >&2
  return 1
}

# A failed clone usually cleans up after itself, but not always. Only ever
# inside the workspace, and only a path we just built ourselves.
discard_partial_clone() {
  local dest="${1:-}"
  [[ -n "$dest" && -n "${AI4DEV_WORKSPACE:-}" && "$dest" == "$AI4DEV_WORKSPACE"/* ]] || return 0
  [[ -e "$dest" ]] && rm -rf "$dest"
  return 0
}

cmd_init() {
  load_config
  info "workspace: $AI4DEV_WORKSPACE"
  info "kit:       $AI4DEV_KIT  (this repository — you are already in it)"
  printf '\n'
  mkdir -p "$AI4DEV_WORKSPACE"

  local repo
  for repo in tinder4dogs tinder4dogs-legacy; do
    if [[ -d "$AI4DEV_WORKSPACE/$repo/.git" ]]; then
      ok "$repo already cloned"
    else
      clone_repo "$repo" "$AI4DEV_WORKSPACE/$repo" || true
    fi
  done

  if [[ -d "$AI4DEV_WORKSPACE/tinder4dogs/.git" ]]; then
    if ( cd "$AI4DEV_WORKSPACE/tinder4dogs" \
         && git fetch --quiet --tags \
         && git checkout --quiet "$AI4DEV_START_TAG" ) 2>/dev/null; then
      ok "product at tag $AI4DEV_START_TAG"
    else
      warn "tag $AI4DEV_START_TAG not found — the facilitator will say which tag to use"
    fi
  fi

  printf '\n'
  info "$AI4DEV_WORKSPACE/"
  info "├── tinder4dogs/             the product. No AI inside it."
  info "└── tinder4dogs-legacy/      the same product, as inherited three years ago."
  printf '\n'
  info "The gateway and the observability stack are not here, and not on your machine."
  info "They are operated for you. You will be shown them on the projector."
  printf '\n'
  info "$AI4DEV_KIT/                 yours. It grows every module, and it goes home with you."
  printf '\n'
  ok "ready. Now run: ai4dev doctor"
}

cmd_doctor() {
  load_config
  FAILED=0
  printf '%sai4dev doctor%s  (v%s)\n\n' "$B" "$N" "$AI4DEV_VERSION"

  # toolchain
  if command -v mise >/dev/null 2>&1; then ok "mise $(mise --version 2>/dev/null | head -1)"
  else bad "mise not found" "brew install mise, then add 'eval \"\$(mise activate zsh)\"' to your shell profile"; fi

  if command -v git >/dev/null 2>&1; then ok "git $(git --version | awk '{print $3}')"
  else bad "git not found" "brew install git"; fi

  local gitname gitmail
  gitname="$(git config --global user.name  2>/dev/null || true)"
  gitmail="$(git config --global user.email 2>/dev/null || true)"
  if [[ -n "$gitname" && -n "$gitmail" ]]; then ok "git identity: $gitname <$gitmail>"
  else bad "git identity not configured" "git config --global user.name '...' && git config --global user.email '...'"; fi

  if command -v jq >/dev/null 2>&1; then ok "jq present"; else bad "jq not found" "brew install jq"; fi

  if command -v betterleaks >/dev/null 2>&1; then ok "betterleaks present"
  else bad "betterleaks not found" "brew install betterleaks"; fi

  # container runtime — for the product's own database only
  if docker info >/dev/null 2>&1; then
    local runtime="docker"
    if docker context show 2>/dev/null | grep -qi orb; then runtime="OrbStack"; fi
    ok "container runtime reachable ($runtime)"
  elif command -v podman >/dev/null 2>&1 && podman info >/dev/null 2>&1; then
    ok "container runtime reachable (podman)"
  else
    bad "no container runtime is running" "start OrbStack, Docker Desktop or Podman. Only needed for the product database."
  fi

  # config file — it holds your key, so its permissions are part of the check
  local mode; mode="$(config_mode)"
  case "$mode" in
    missing) bad "no config file at $CONFIG_FILE" "copy config.example from your kit into it" ;;
    600|400) ok  "config file $CONFIG_FILE (mode $mode)" ;;
    *)       bad "config file is readable by others (mode $mode)" \
                 "chmod 600 $CONFIG_FILE  — your virtual key is in it" ;;
  esac

  # the assistant
  #
  # A missing opencode is a priming failure: it is on the list of things to
  # install before day 1. An unwired opencode is not — the config needs the
  # gateway URL and a key, and the key only exists once you are in the room.
  if command -v opencode >/dev/null 2>&1; then
    local ocv; ocv="$(opencode --version 2>/dev/null | head -1)"
    ok "opencode ${ocv:-present}"
    if [[ -f "$OPENCODE_CONFIG_FILE" ]] && jq -e '.provider.ai4dev' "$OPENCODE_CONFIG_FILE" >/dev/null 2>&1; then
      ok "opencode points at the course gateway"
    else
      warn "opencode is not wired to the gateway yet — 'ai4dev code' writes that config the first time you run it"
    fi
  else
    bad "opencode not found" "brew install anomalyco/tap/opencode   (or: curl -fsSL https://opencode.ai/install | bash)"
  fi

  # kit and workspace
  if [[ -f "$AI4DEV_KIT/prompts/code_review.md" ]]; then ok "kit at $AI4DEV_KIT"
  else bad "kit looks incomplete at $AI4DEV_KIT" "re-clone the kit repository"; fi

  if [[ -d "$AI4DEV_WORKSPACE/tinder4dogs/.git" ]]; then
    local tag; tag="$(cd "$AI4DEV_WORKSPACE/tinder4dogs" && git describe --tags --exact-match 2>/dev/null || echo "no tag")"
    if [[ "$tag" == "$AI4DEV_START_TAG" ]]; then ok "product at $AI4DEV_START_TAG"
    else warn "product is at '$tag', expected $AI4DEV_START_TAG"; fi
  else
    warn "product not cloned — expected before the session. Run 'ai4dev init' when told to."
  fi

  # the two that matter
  #
  # Before day 1 nobody has a key yet: it is issued in the room. A missing key
  # is therefore not a failure, it is the expected state during priming, and
  # doctor must say so instead of printing a red line at somebody who did
  # everything right.
  printf '\n'
  local key have_key=0
  if key="$(fetch_key)"; then
    ok "virtual key present (${key:0:7}…)"
    have_key=1
  else
    warn "no virtual key yet — normal before day 1, you receive it by Slack DM in the room"
  fi

  if [[ "$have_key" -eq 0 ]]; then
    printf '\n'
    if [[ "$FAILED" -eq 0 ]]; then
      printf '%s✓ ready for day 1%s — everything you can check yourself is green.\n' "$G" "$N"
      info "  The key and the first traced request are the first thing we do in the room."
      exit 0
    fi
    printf '%s✗ fix the red lines above%s — ask on Slack, that is what it is for\n' "$R" "$N"
    exit 1
  fi

  local probe_body probe_meta pcode pctype preason
  probe_body="$(mktemp)"
  probe_meta="$(curl -sS --max-time 15 -o "$probe_body" -w '%{http_code} %{content_type}' \
                 "${AI4DEV_GATEWAY_URL:-http://invalid}/models" 2>/dev/null || true)"
  read -r pcode pctype <<< "${probe_meta:-000}"

  if [[ -z "$AI4DEV_GATEWAY_URL" ]]; then
    bad "AI4DEV_GATEWAY_URL is not set" "see $CONFIG_FILE"
  elif [[ -z "$pcode" || "$pcode" == "000" ]]; then
    bad "could not reach $(url_host "$AI4DEV_GATEWAY_URL")" "check your network and VPN, then AI4DEV_GATEWAY_URL in $CONFIG_FILE"
  elif preason="$(not_json_reason "$probe_body" "$pctype")"; then
    bad "$(url_host "$AI4DEV_GATEWAY_URL") answered with $preason (HTTP $pcode)" \
        "almost always a VPN or corporate proxy intercepting the request: disconnect it, or ask for $(url_host "$AI4DEV_GATEWAY_URL") to be allow-listed"
  else
    local reply
    reply="$(call reviewer "Reply with exactly: ready" "task=doctor" 2>/dev/null || true)"
    if [[ -n "$reply" ]]; then
      ok "gateway reachable, one request traced: \"$(printf '%s' "$reply" | head -c 40)\""
      cmd_costs --brief || true
    else
      bad "the gateway did not answer" "check AI4DEV_GATEWAY_URL, then ask on Slack"
    fi
  fi
  rm -f "$probe_body"

  printf '\n'
  if [[ "$FAILED" -eq 0 ]]; then
    printf '%s✓ you are ready%s\n' "$G" "$N"
  else
    printf '%s✗ fix the red lines above%s — ask on Slack, that is what it is for\n' "$R" "$N"; exit 1
  fi
}

cmd_review() {
  load_config
  local file="${1:-}"
  [[ -n "$file" ]] || die "usage: ai4dev review <file>"
  [[ -f "$file" ]] || die "no such file: $file"

  local template="$AI4DEV_KIT/prompts/code_review.md"
  [[ -f "$template" ]] || die "no review prompt at $template"

  local lang="${file##*.}"
  local prompt; prompt="$(render "$template" CODE "$(cat "$file")" LANGUAGE "$lang" FILE "$file")"

  info "reviewing $file with $template"
  printf '\n'
  call reviewer "$prompt" "task=code_review,file=$(basename "$file"),language=$lang"
}

cmd_commit() {
  load_config
  git rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository"
  git diff --staged --quiet && die "nothing staged. git add something first."

  local template="$AI4DEV_KIT/prompts/commit_message.md"
  [[ -f "$template" ]] || die "no commit prompt at $template"

  local branch; branch="$(git rev-parse --abbrev-ref HEAD)"
  local msg;    msg="$(call committer \
                        "$(render "$template" DIFF "$(git diff --staged)" BRANCH "$branch")" \
                        "task=commit,branch=$branch")"

  printf '\n%s%s%s\n\n' "$B" "$msg" "$N"
  read -rp "Commit with this message? [y/N] " answer
  if [[ "$answer" == "y" || "$answer" == "Y" ]]; then
    printf '%s' "$msg" | git commit --quiet -F -
    ok "committed"
  else
    info "not committed. The message is above if you want to edit it."
  fi
}

# ask — the loop with nothing in front of it.
#
# 'review' and 'commit' send a prompt from your kit. 'ask' sends exactly what
# you typed, to exactly the alias you named, and tells you what it cost. It is
# the command you use when you are measuring the model rather than using it.
cmd_ask() {
  load_config

  local model="frontier" temp="" n=1 prompt_file="" prompt=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --model)            model="${2:-}";       shift 2 ;;
      --temp|--temperature) temp="${2:-}";      shift 2 ;;
      --n|-n)             n="${2:-}";           shift 2 ;;
      --prompt-file)      prompt_file="${2:-}"; shift 2 ;;
      --)                 shift; prompt="$*";   break   ;;
      -*)                 die "unknown option: $1" ;;
      *)                  prompt="$*";          break   ;;
    esac
  done

  if [[ -n "$prompt_file" ]]; then
    [[ -f "$prompt_file" ]] || die "no such prompt file: $prompt_file"
    prompt="$(cat "$prompt_file")"
  fi
  [[ -n "$prompt" ]] || die "nothing to ask. Give a prompt, or --prompt-file <path>."
  [[ -n "$model" ]]  || die "--model needs an alias: frontier, cheap, open-hosted, reviewer, …"
  [[ "$n" =~ ^[0-9]+$ && "$n" -ge 1 && "$n" -le 20 ]] || die "--n must be a whole number from 1 to 20."
  [[ -z "$temp" || "$temp" =~ ^[0-9]+(\.[0-9]+)?$ ]] || die "--temp must be a number, for example 0.0 or 1.0."

  local i total="0"
  local answer
  for ((i = 1; i <= n; i++)); do
    [[ "$n" -gt 1 ]] && printf '\n%s── run %d of %d ─────────────────────────────%s\n' "$D" "$i" "$n" "$N"

    # The status of the call has to be checked, not assumed. call() runs in a
    # command substitution, so its failure does not stop the surrounding
    # printf — and the footer, which reads the last line of the ledger, would
    # then print the PREVIOUS request's tokens and cost under a request that
    # never happened and never cost anything. A number attached to the wrong
    # thing is worse than no number.
    if ! answer="$(call "$model" "$prompt" "task=ask" "$temp")"; then
      exit 1
    fi

    printf '\n%s\n\n' "$answer"
    last_call_footer
    total="$(awk -v a="$total" -v b="$(last_call_cost)" 'BEGIN{printf "%.6f", a+b}')"
  done

  if [[ "$n" -gt 1 ]]; then
    printf '\n%s%d runs · $%s total%s\n' "$D" "$n" "$total" "$N"
    info "Same prompt, same alias, same settings. Read them before you explain them."
  fi
}

# ─── the assistant ───────────────────────────────────────────────────────────
#
# ai4dev code — start OpenCode against the course gateway.
#
# The whole command is one sentence: the key stays in this kit, and the
# assistant borrows it for the life of one process.
#
# The obvious alternative is to export AI4DEV_API_KEY from your shell profile.
# That works, and it puts your virtual key into the environment of every process
# you start for the rest of the week, including whatever a package manager
# decides to run. This puts it in exactly one process, the one you asked for.
#
# The OpenCode config written below names the gateway and the aliases. It does
# NOT contain the key: it contains the literal string {env:AI4DEV_API_KEY},
# which OpenCode resolves from the environment we set here. So the file is safe
# to read, safe to copy, safe to screenshot, and worth nothing to anyone who
# takes it. That is the difference between configuration and a credential, and
# it is the same distinction Module 3 asks you to make about AGENTS.md.

gateway_model_ids() {
  # Ask the gateway which aliases this key may actually use, instead of keeping
  # a copy of the list in here. A model added to the gateway shows up in
  # OpenCode on the next `ai4dev code`, with no new CLI release.
  #
  # "this key may use" is literal: /models answers per-key. An alias the
  # gateway serves but the key is not entitled to will not be in this list,
  # and that is a key problem, not a CLI one.
  #
  # The `-fallback` aliases are filtered out on purpose: they are what the
  # router reaches for when a primary fails, not something a human picks.
  local key="${1:-}" body
  body="$(curl -sS --max-time 15 "$AI4DEV_GATEWAY_URL/models" \
            -H "Authorization: Bearer $key" 2>/dev/null)" || return 1
  printf '%s' "$body" | jq -e '
      [ .data[]?.id ]
      | map(select(endswith("-fallback") | not))
      | unique
      | select(length > 0)' 2>/dev/null
}

sync_opencode_config() {
  # Rewrites ONLY .provider.ai4dev and .model, and leaves the rest of the file
  # exactly as it was. That matters more than it sounds: Module 4 has people
  # editing the `permission` block in this same file, and a tool that helpfully
  # regenerates the whole thing would delete an exercise.
  local key="${1:-}" force="${2:-0}"
  local ids default existing before_list before_model after_list after_model tmp

  existing='{}'
  if [[ -f "$OPENCODE_CONFIG_FILE" ]]; then
    if ! existing="$(jq '.' "$OPENCODE_CONFIG_FILE" 2>/dev/null)"; then
      if [[ "$force" -ne 1 ]]; then
        bad "$OPENCODE_CONFIG_FILE is not valid JSON" "fix it, or: ai4dev code --reconfigure"
        exit 1
      fi
      cp "$OPENCODE_CONFIG_FILE" "$OPENCODE_CONFIG_FILE.broken.$(date +%s)"
      warn "kept a copy of the unreadable file next to it"
      existing='{}'
    fi
  fi

  if ! ids="$(gateway_model_ids "$key")"; then
    if [[ -f "$OPENCODE_CONFIG_FILE" ]]; then
      warn "could not reach the gateway — leaving your OpenCode config as it is"
      return 0
    fi
    warn "could not ask the gateway for your model list, writing the course defaults"
    ids='["cheap","frontier","open-hosted"]'
  fi

  default="$AI4DEV_OPENCODE_MODEL"
  if ! printf '%s' "$ids" | jq -e --arg d "$default" 'index($d) != null' >/dev/null 2>&1; then
    warn "$default is not one of your aliases — using $(printf '%s' "$ids" | jq -r '.[0]') instead"
    default="$(printf '%s' "$ids" | jq -r '.[0]')"
  fi

  before_list="$(printf '%s' "$existing" | jq -c '(.provider.ai4dev.models // {}) | keys')"
  before_model="$(printf '%s' "$existing" | jq -r '.model // ""')"

  mkdir -p "$(dirname "$OPENCODE_CONFIG_FILE")"
  tmp="$OPENCODE_CONFIG_FILE.tmp.$$"
  printf '%s' "$existing" | jq \
    --arg url "$AI4DEV_GATEWAY_URL" --arg default "$default" --argjson ids "$ids" '
      .["$schema"] = (.["$schema"] // "https://opencode.ai/config.json")
    | .provider.ai4dev = {
        npm: "@ai-sdk/openai-compatible",
        name: "AI4Dev gateway",
        options: { baseURL: $url, apiKey: "{env:AI4DEV_API_KEY}" },
        models: (
          $ids
          | map({ key: ., value: { name: (if . == $default then . + " (default)" else . end) } })
          | from_entries
        )
      }
    | .model = ("ai4dev/" + $default)
  ' > "$tmp" || { rm -f "$tmp"; die "could not write $tmp"; }
  mv "$tmp" "$OPENCODE_CONFIG_FILE"

  after_list="$(jq -c '.provider.ai4dev.models | keys' "$OPENCODE_CONFIG_FILE")"
  after_model="$(jq -r '.model' "$OPENCODE_CONFIG_FILE")"

  if [[ "$before_list" != "$after_list" || "$before_model" != "$after_model" || "$force" -eq 1 ]]; then
    ok "OpenCode config updated: $(printf '%s' "$ids" | jq -r 'length') models, default $default"
    [[ "$before_model" != "$after_model" && -n "$before_model" ]] \
      && info "default was $before_model"
    info "switch model in OpenCode with /models · keep another default:"
    info "  echo 'AI4DEV_OPENCODE_MODEL=\"frontier\"' >> $CONFIG_FILE"
  fi
}

cmd_code() {
  load_config
  require_gateway

  local reconfigure=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --reconfigure) reconfigure=1; shift ;;
      --)            shift; break ;;
      *)             break ;;
    esac
  done

  command -v opencode >/dev/null 2>&1 \
    || die "opencode not found. Install it with:  brew install anomalyco/tap/opencode   (or: curl -fsSL https://opencode.ai/install | bash)"
  command -v jq >/dev/null 2>&1 || die "jq not found. brew install jq"

  local key
  key="$(fetch_key)" \
    || die "no virtual key yet. Paste the one from your Slack DM into $CONFIG_FILE, then try again."

  # Every run, not just the first. The model list lives on the gateway and
  # changes there; a config written in Module 1 should not still be describing
  # Module 1 in Module 8. Quiet when nothing changed.
  #
  # Redirected to stderr, and that redirect is load-bearing. `ai4dev code run`
  # passes straight through to `opencode run`, which people pipe:
  #
  #     ai4dev code run --format json "..." > run.jsonl
  #
  # A friendly "OpenCode config updated" line on stdout lands in the middle of
  # that file and breaks whatever reads it. Progress goes to stderr; only the
  # wrapped tool's output belongs on stdout.
  sync_opencode_config "$key" "$reconfigure" >&2

  # Everywhere else in the course a model is a bare alias: `ai4dev ask
  # --model cheap`. OpenCode wants provider/model and splits on the first "/",
  # so `--model cheap` becomes provider "cheap" with an empty model, and the
  # user gets "UnknownError: Unexpected server error" with nothing to act on.
  # Qualify bare aliases with our provider; leave anything with a "/" alone,
  # and stop at a bare "--" so literal arguments are never touched.
  local args=() a qualified=""
  while [[ $# -gt 0 ]]; do
    a="$1"; shift
    case "$a" in
      --) args+=("$a" "$@"); break ;;
      -m|--model)
        if [[ $# -gt 0 && "$1" != */* && "$1" != -* ]]; then
          args+=("$a" "ai4dev/$1"); qualified="$1"; shift
        else
          args+=("$a")
        fi ;;
      --model=*|-m=*)
        if [[ "${a#*=}" != */* ]]; then
          args+=("${a%%=*}=ai4dev/${a#*=}"); qualified="${a#*=}"
        else
          args+=("$a")
        fi ;;
      *) args+=("$a") ;;
    esac
  done
  [[ -n "$qualified" ]] && info "model: ai4dev/$qualified" >&2

  # The key enters the environment of this process, which is about to be
  # replaced by OpenCode. No shell survives this line holding it.
  export AI4DEV_API_KEY="$key"
  # Same treatment for a GitHub token, when `ai4dev mcp add github --token`
  # stored one. The OpenCode config refers to it by name, never by value.
  [[ -n "${AI4DEV_GITHUB_TOKEN:-}" ]] && export AI4DEV_GITHUB_TOKEN
  exec opencode ${args[@]+"${args[@]}"}
}

cmd_costs() {
  # --last reads your own ledger, not the gateway: it is the only one of the
  # three records that knows how long you waited.
  if [[ "${1:-}" == "--last" ]]; then
    local n="${2:-1}"
    [[ "$n" =~ ^[0-9]+$ && "$n" -ge 1 ]] || die "--last takes a whole number, for example: ai4dev costs --last 3"
    [[ -f "$LEDGER" ]] || die "no requests recorded yet on this machine. Make one, then ask again."

    printf '\n%s%-20s %-12s %-26s %7s %7s %10s %7s%s\n' "$B" \
      "when (UTC)" "alias" "model that answered" "in" "out" "cost" "secs" "$N"

    tail -n "$n" "$LEDGER" \
      | jq -r '[.when, .alias, (.model // "?"), (.tokens_in|tostring), (.tokens_out|tostring),
                (.cost|tostring), (.latency_s|tostring)] | @tsv' \
      | while IFS=$'\t' read -r when alias model tin tout cost lat; do
          printf '%-20s %-12s %-26.26s %7s %7s %10.6f %7.2f\n' \
            "${when%Z}" "$alias" "$model" "$tin" "$tout" "$cost" "$lat"
        done

    local sum count
    count="$(tail -n "$n" "$LEDGER" | wc -l | tr -d ' ')"
    sum="$(tail -n "$n" "$LEDGER" | jq -s 'map(.cost) | add // 0' | awk '{printf "%.6f", $0}')"
    printf '\n%s  $%s across the last %s request%s%s\n' "$D" "$sum" "$count" \
      "$([[ "$count" -eq 1 ]] || printf s)" "$N"
    info "The gateway charged you this. The dashboard can show you what you sent for it."

    # This ledger holds only what THIS CLI sent. Your assistant talks to the
    # gateway directly, so none of its requests are in here — and the newest row
    # will happily be an hour old while looking exactly like the thing you just
    # did. A real number attached to the wrong event is worse than no number, so
    # say the boundary out loud rather than trusting anyone to infer it from a
    # timestamp they did not read.
    info "Only requests made by this CLI are recorded here — not your assistant's."
    info "For everything on your key, including the assistant: ai4dev costs"
    return 0
  fi

  load_config
  require_gateway
  local brief=0; [[ "${1:-}" == "--brief" ]] && brief=1

  local key; key="$(fetch_key)" || die "could not fetch your virtual key"

  local base="${AI4DEV_GATEWAY_URL%/v1}"
  local info_json body_file meta code ctype reason
  body_file="$(mktemp)"
  meta="$(curl -sS --max-time 15 -o "$body_file" -w '%{http_code} %{content_type}' \
            "$base/key/info" -H "Authorization: Bearer $key" 2>/dev/null)" \
    || { rm -f "$body_file"; die "could not reach $(url_host "$base") — check your network and VPN"; }
  read -r code ctype <<< "$meta"
  if reason="$(not_json_reason "$body_file" "$ctype")"; then
    rm -f "$body_file"
    gateway_not_json_die "$base/key/info" "$code" "$reason"
  fi
  info_json="$(cat "$body_file")"; rm -f "$body_file"

  local spend budget
  spend="$( printf '%s' "$info_json" | jq -r '.info.spend      // .spend      // 0')"
  budget="$(printf '%s' "$info_json" | jq -r '.info.max_budget // .max_budget // "unlimited"')"

  if [[ "$budget" == "unlimited" || "$budget" == "null" ]]; then
    printf '  spent: %s%.4f%s\n' "$B" "$spend" "$N"
  else
    printf '  spent: %s%.4f%s of %s   (%s left)\n' "$B" "$spend" "$N" "$budget" \
      "$(awk -v b="$budget" -v s="$spend" 'BEGIN{printf "%.4f", b-s}')"
  fi

  [[ "$brief" -eq 1 ]] && return 0

  printf '\n'
  info "Your traces: ${AI4DEV_DASHBOARD_URL:-<dashboard URL not configured>}"
  info "Open one and find four things: input tokens, output tokens, cost, and exactly what was sent."
}

# upgrade — update the tool, not your work.
#
# The kit is one repository holding two different things: a tool the course
# ships and keeps changing, and work that is yours from Kit Zero onward. A
# 'git pull' cannot tell them apart, and by Module 2 your branch has diverged
# from the course's anyway, so a fast-forward is not even available.
#
# So this does not pull. It checks out the course-owned paths from origin/main
# and commits only those. Your prompts, checklists, decisions and notes are
# never touched, and there is no merge to resolve because the two sets of files
# do not overlap.
# version_ge <a> <b>  — true when a is at least b.
#
# 'sort -V' is the obvious tool and it is not on every BSD userland, so this
# falls back to comparing the three numbers by hand. It matters here because
# the only thing this command must never do is report a downgrade as an
# upgrade, and a missing flag is not a good enough reason to get that wrong.
version_ge() {
  local a b
  IFS=. read -r a1 a2 a3 <<< "${1:-0.0.0}"
  IFS=. read -r b1 b2 b3 <<< "${2:-0.0.0}"
  for a in a1 a2 a3 b1 b2 b3; do
    [[ "${!a}" =~ ^[0-9]+$ ]] || printf -v "$a" '0'
  done
  (( a1 != b1 )) && { (( a1 > b1 )); return; }
  (( a2 != b2 )) && { (( a2 > b2 )); return; }
  (( a3 >= b3 ))
}

cmd_upgrade() {
  load_config

  local force=0
  [[ "${1:-}" == "--force" ]] && force=1

  local kit="$KIT_ROOT"
  [[ -d "$kit/.git" ]] || die "$kit is not a git repository. Re-clone your kit and copy your work across."
  git -C "$kit" remote get-url origin >/dev/null 2>&1 || die "this kit has no 'origin' remote, so there is nothing to upgrade from."

  # Your own edits to a course-owned file would be overwritten. Stop instead.
  if ! git -C "$kit" diff --quiet -- "${COURSE_OWNED[@]}" 2>/dev/null \
     || ! git -C "$kit" diff --cached --quiet -- "${COURSE_OWNED[@]}" 2>/dev/null; then
    bad "you have uncommitted changes in ${COURSE_OWNED[*]}"
    info "commit or stash them first: the upgrade would overwrite them."
    exit 1
  fi

  info "fetching from $(git -C "$kit" remote get-url origin)"
  git -C "$kit" fetch --quiet origin main 2>/dev/null \
    || die "could not reach the course repository. Check your network, then try again."

  local changed
  changed="$(git -C "$kit" diff --name-only HEAD origin/main -- "${COURSE_OWNED[@]}" 2>/dev/null || true)"

  if [[ -z "$changed" ]]; then
    ok "already up to date — ai4dev $AI4DEV_VERSION"
    return 0
  fi

  # "Different from origin" is not the same as "older than origin". If your
  # branch carries commits to the tool that the course repository has not seen,
  # taking origin's copy is a DOWNGRADE, and the command would announce it as an
  # upgrade. That happened once, to the person who wrote this command, because
  # he had not pushed. Stop instead.
  local ahead
  ahead="$(git -C "$kit" log --oneline origin/main..HEAD -- "${COURSE_OWNED[@]}" 2>/dev/null || true)"
  if [[ -n "$ahead" && "$force" -eq 0 ]]; then
    bad "your copy of the tool is ahead of the course repository"
    printf '\n'
    printf '%s\n' "$ahead" | while IFS= read -r commit_line; do
      [[ -n "$commit_line" ]] || continue
      printf '  %s%s%s\n' "$D" "$commit_line" "$N"
    done
    printf '\n'
    info "Those commits touch ${COURSE_OWNED[*]} and origin/main does not have them."
    info "Upgrading now would replace newer files with older ones."
    printf '\n'
    info "If they are yours and belong upstream:  git push"
    info "If you really want the course's version: ai4dev upgrade --force"
    exit 1
  fi

  printf '\n%sthis will replace:%s\n' "$B" "$N"
  printf '  %s\n' $changed
  printf '\n'

  git -C "$kit" checkout origin/main -- "${COURSE_OWNED[@]}"
  git -C "$kit" commit --quiet -m "kit: update the ai4dev tool from the course" -- "${COURSE_OWNED[@]}" \
    || info "nothing to commit — the files were already staged as they are"

  # This script has just overwritten itself while running. Bash has already read
  # and parsed everything it needs (every command lives inside a function, and
  # the last line of the file has been read), so finishing is safe — but the NEW
  # version has to be asked for its version by running it, not by reading
  # AI4DEV_VERSION, which is still the old value in this process.
  local before="$AI4DEV_VERSION" after
  after="$("$kit/bin/ai4dev" version 2>/dev/null | awk '{print $2}')"
  [[ -n "$after" ]] || after="?"

  if [[ "$after" == "$before" ]]; then
    ok "tool files updated — still ai4dev $before"
  elif [[ "$after" == "?" ]]; then
    warn "tool files updated, but the new version does not run. Check 'ai4dev version'."
  elif version_ge "$after" "$before"; then
    ok "upgraded: ai4dev $before → $after"
  else
    warn "DOWNGRADED: ai4dev $before → $after"
    info "That is what the course repository currently holds. If it should be newer, it was never pushed."
  fi
  info "Your prompts, checklists, decisions and notes were not touched."
}

cmd_key() {
  load_config
  local key mode
  mode="$(config_mode)"
  if key="$(fetch_key)"; then
    ok "virtual key present (${key:0:7}…)"
    if [[ "$mode" == "600" || "$mode" == "400" ]]; then
      info "in $CONFIG_FILE, mode $mode. Never printed in full, here or anywhere else."
    else
      warn "$CONFIG_FILE is mode $mode — anyone on this machine can read your key"
      info "chmod 600 $CONFIG_FILE"
    fi
  else
    printf '%s✗%s AI4DEV_API_KEY is not set\n' "$R" "$N"
    info "it was sent to you by Slack DM. Paste it into $CONFIG_FILE."
    info "if you never received it, or you have lost it, ask on Slack for a new one."
    exit 1
  fi
}

cmd_config() {
  load_config
  printf '%sresolved configuration%s  (%s)\n\n' "$B" "$N" "$CONFIG_FILE"
  printf '  AI4DEV_KIT           %s\n' "$AI4DEV_KIT"
  printf '  AI4DEV_WORKSPACE     %s\n' "$AI4DEV_WORKSPACE"
  printf '  AI4DEV_GATEWAY_URL   %s\n' "${AI4DEV_GATEWAY_URL:-<unset>}"
  printf '  AI4DEV_DASHBOARD_URL %s\n' "${AI4DEV_DASHBOARD_URL:-<unset>}"
  printf '  AI4DEV_GIT_BASE      %s\n' "$AI4DEV_GIT_BASE"
  printf '  AI4DEV_START_TAG     %s\n' "$AI4DEV_START_TAG"
  printf '  AI4DEV_API_KEY       %s\n' "$([[ -n "${AI4DEV_API_KEY:-}" ]] && printf '%s…  (config mode %s)' "${AI4DEV_API_KEY:0:7}" "$(config_mode)" || printf '<unset>')"
  printf '\n'
  info "Only the first characters of your key are ever shown, here or anywhere else."
}

# ── module ──────────────────────────────────────────────────────────────────
#
# The course repository carries one tag per module boundary, all of them on
# main: module-01-start, module-01-end, module-04-start, module-04-end and so
# on. This command puts you on one of them.
#
# Three rules it never breaks:
#   - it refuses if you have uncommitted work, and tells you how to keep it
#   - it puts you on a real local branch, never a detached HEAD, so your work
#     has somewhere to live and `git status` says something useful
#   - `end` does NOT touch your working tree by default. The solution is
#     something to compare against, not something to be overwritten by.

module_repo() {
  local repo="${AI4DEV_WORKSPACE:-$HOME/ai4dev}/tinder4dogs"
  [[ -d "$repo/.git" ]] || die "no course repository at $repo — run: ai4dev init"
  printf '%s' "$repo"
}

module_number() {
  # accepts 4, 04, m4, module-04
  local raw="${1:-}"
  raw="${raw#module-}"; raw="${raw#m}"
  case "$raw" in
    ''|*[!0-9]*) return 1 ;;
  esac
  printf '%02d' "$((10#$raw))"
}

module_fetch() {
  git fetch --tags --quiet origin 2>/dev/null \
    || warn "could not reach the remote, using the tags you already have"
}

module_require_clean() {
  [[ -z "$(git status --porcelain)" ]] && return 0
  printf '\n'
  bad "you have uncommitted changes, so nothing has been moved"
  info "keep them:     git add -A && git commit -m 'wip'"
  info "park them:     git stash push -u -m 'before module'"
  info "discard them:  git reset --hard   (this is not reversible)"
  exit 1
}

cmd_module() {
  local n where repo tag branch
  n="$(module_number "${1:-}")" || {
    printf 'usage: ai4dev module <number> start\n'
    printf '       ai4dev module <number> end [--mine|--checkout]\n\n'
    info "start              put me at the beginning of the module, on my own branch"
    info "end                show me how it was solved, as a diff"
    info "end --mine         show me how far my work is from it"
    info "end --checkout     put the solution on a branch beside mine, so I can run it"
    exit 2
  }
  where="${2:-start}"
  local shown="${n#0}"          # "04" is right for a tag and wrong in a sentence
  repo="$(module_repo)"
  cd "$repo" || die "cannot enter $repo"

  case "$where" in
    start)
      tag="module-${n}-start"
      branch="m${n}"
      module_fetch
      git rev-parse -q --verify "refs/tags/$tag" >/dev/null \
        || die "$tag does not exist yet — that module has not been prepared"
      module_require_clean
      git switch -C "$branch" "$tag" --quiet \
        || die "could not switch to $tag"
      ok "you are at the start of module $shown, on branch $branch"
      info "the tag itself: $tag"
      info "commit as often as you like — this branch is yours"
      info "when you want to see how it was solved: ai4dev module $shown end"
      ;;
    end)
      # Three questions, and they are not the same question:
      #
      #   how was it solved?        the author's change, start..end. The default,
      #                             because it is what somebody typing `end` wants.
      #   how far am I from it?     --mine. Noisier by nature: it contains every
      #                             change you made, inverted.
      #   let me run it.            --checkout, a branch beside your own.
      #
      # It used to print only `diff --stat`, which answers none of the three: a
      # list of filenames is a signpost, not an answer, and it cost a second
      # command to get to the thing everybody was actually asking for.
      tag="module-${n}-end"
      base="module-${n}-start"
      module_fetch
      git rev-parse -q --verify "refs/tags/$tag" >/dev/null \
        || die "$tag does not exist yet — the solution is published after the module"

      local mode="how"
      case "${3:-${1:-}}" in
        --checkout) mode="checkout" ;;
        --mine)     mode="mine" ;;
      esac

      case "$mode" in
        checkout)
          module_require_clean
          git switch -C "m${n}-solution" "$tag" --quiet \
            || die "could not switch to $tag"
          ok "you are on the reference solution, on branch m${n}-solution"
          info "your own work is still on m${n} — git switch m${n} to go back"
          ;;
        mine)
          ok "how your work differs from the reference solution for module $shown"
          printf '\n'
          if git diff --quiet HEAD "$tag"; then
            info "nothing — your tree is identical to $tag"
            printf '\n'
          else
            git --no-pager diff --stat HEAD "$tag" || true
            printf '\n'
            git diff HEAD "$tag" || true
            printf '\n'
          fi
          info "how it was solved, on its own:  ai4dev module $shown end"
          warn "your working tree has NOT been touched"
          ;;
        *)
          # If the start tag is missing, the change is still the commit itself.
          git rev-parse -q --verify "refs/tags/$base" >/dev/null || base="${tag}^"
          ok "how module $shown was solved — $base..$tag"
          printf '\n'
          # Subject only, deliberately. The body of these commits is written for
          # whoever prepares the module and can carry answer-key material; it is
          # one command away for anyone who wants it, and that is the right
          # distance.
          git --no-pager log -1 --format='%s' "$tag"
          printf '\n'
          git --no-pager diff --stat "$base" "$tag" || true
          printf '\n'
          git diff "$base" "$tag" || true
          printf '\n'
          info "why it was done this way:          git log -1 $tag"
          info "how far your own work is from it:  ai4dev module $shown end --mine"
          info "check it out and run it:           ai4dev module $shown end --checkout"
          warn "your working tree has NOT been touched"
          ;;
      esac
      ;;
    *)
      die "ai4dev module $shown <start|end>"
      ;;
  esac
}

# ─── sdd — the spec-driven harness, installed into the product repo ──────────
#
# cc-sdd writes slash-commands, skills and templates into the repository you
# run it in. Two things about that are worth knowing before it runs:
#
#   1. It writes AGENTS.md, and with --yes it overwrites the one that is
#      already there. In this course that file is the artefact the room wrote
#      by hand in Module 3, so losing it costs a module. We keep it, and append
#      cc-sdd's own guidance below it between markers.
#   2. `--overwrite skip` is not the answer: it skips the whole plan, new files
#      included, and installs nothing. Measured on 3.1.0.
#
# The version is pinned. A course that installs "latest" is a course that
# behaves differently in the afternoon than it did in rehearsal.
readonly CC_SDD_VERSION="${AI4DEV_CC_SDD_VERSION:-3.1.0}"
readonly SDD_MARK_BEGIN="<!-- ai4dev:cc-sdd:begin -->"
readonly SDD_MARK_END="<!-- ai4dev:cc-sdd:end -->"

# Typing `/kiro-spec-init <text>` in OpenCode works, even though the `/` popup
# answers "No matching items" while you type it: the popup lists commands only,
# but on submit OpenCode resolves the name against the skills too, inlines that
# SKILL.md into the message and substitutes $ARGUMENTS. Measured on 1.18.31.
#
# So the commands below are optional, and off by default. They buy one thing:
# the palette suggests the 17 phases and shows what each one does, instead of
# telling a room of people that the command they were just told to run does not
# exist. Each one inlines the same SKILL.md, so the instructions do not move.
#
# The cost: the wrapper runs a shell command (`sed` over the skill file) when
# you submit it. Under a config with bash set to "ask" that is one more prompt.
sdd_skill_field() {
  # sdd_skill_field <SKILL.md> <field>
  awk -v f="$2" '
    NR == 1 && $0 == "---" { inf = 1; next }
    inf && $0 == "---"     { exit }
    inf {
      key = $0; sub(/:.*/, "", key)
      if (key == f) { val = $0; sub(/^[^:]*:[[:space:]]*/, "", val); print val; exit }
    }' "$1"
}

sdd_write_wrappers() {
  # prints how many it wrote
  local out=".opencode/command" n=0 skill name desc
  # inlines the skill body (frontmatter stripped) when the command is submitted
  local strip='!`sed -e "1,/^---$/d" .opencode/skills/NAME/SKILL.md`'
  [[ -d .opencode/skills ]] || { printf '0'; return 0; }
  mkdir -p "$out"
  for skill in .opencode/skills/kiro-*/SKILL.md; do
    [[ -f "$skill" ]] || continue
    name="$(sdd_skill_field "$skill" name)"
    [[ -n "$name" ]] || name="$(basename "$(dirname "$skill")")"
    desc="$(sdd_skill_field "$skill" description)"
    [[ -n "$desc" ]] || desc="cc-sdd spec workflow"
    desc="${desc//\\/\\\\}"; desc="${desc//\"/\\\"}"
    {
      printf -- '---\n'
      printf 'description: "%s"\n' "$desc"
      printf -- '---\n'
      # inline the skill itself, minus its frontmatter
      printf '%s\n\n' "${strip/NAME/$name}"
      printf 'The input for this run, which the instructions above ask for:\n\n'
      printf '<input>\n'
      printf '%s\n' '$ARGUMENTS'
      printf '</input>\n'
    } > "$out/$name.md"
    n=$((n + 1))
  done
  printf '%s' "$n"
}

cmd_sdd() {
  local sub="${1:-}"; shift || true

  case "$sub" in
    setup) ;;
    commands)
      git rev-parse --show-toplevel >/dev/null 2>&1 \
        || die "run this inside the course repository (cd ~/ai4dev/tinder4dogs)"
      cd "$(git rev-parse --show-toplevel)" || die "cannot enter the repository root"
      local written; written="$(sdd_write_wrappers)"
      [[ "$written" -gt 0 ]] || die "no kiro-* skills here — run: ai4dev sdd setup"
      ok "$written /kiro-* commands written to .opencode/command/"
      info "restart OpenCode and type / to see them"
      return 0
      ;;
    *) die "usage: ai4dev sdd setup [--lang <code>] [--force] [--commands] · ai4dev sdd commands" ;;
  esac

  local lang="en" force=0 want_commands=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --lang)        lang="${2:-en}"; shift 2 ;;
      --force)       force=1; shift ;;
      --commands)    want_commands=1; shift ;;
      *) die "unknown option: $1" ;;
    esac
  done

  command -v npx >/dev/null 2>&1 || die "npx not found — install Node, then run this again."
  git rev-parse --show-toplevel >/dev/null 2>&1 \
    || die "run this inside the course repository (cd ~/ai4dev/tinder4dogs)"
  local root; root="$(git rev-parse --show-toplevel)"
  cd "$root" || die "cannot enter $root"

  if [[ -d .opencode/skills/kiro-spec-init && "$force" -ne 1 ]]; then
    ok "cc-sdd is already installed here"
    if [[ "$want_commands" -eq 1 ]]; then
      local again; again="$(sdd_write_wrappers)"
      ok "$again /kiro-* commands refreshed in .opencode/command/"
    fi
    info "re-install with: ai4dev sdd setup --force"
    return 0
  fi

  # Keep the room's own AGENTS.md. This is the whole reason this command
  # exists rather than a line in the module page telling people to run npx.
  local had_agents=0 agents_backup=""
  if [[ -f AGENTS.md ]]; then
    had_agents=1
    agents_backup="$(mktemp)"
    cp AGENTS.md "$agents_backup"
  fi

  info "installing cc-sdd $CC_SDD_VERSION for OpenCode…"
  if ! npx -y "cc-sdd@$CC_SDD_VERSION" --opencode-skills --lang "$lang" --yes >/dev/null 2>&1; then
    [[ "$had_agents" -eq 1 ]] && cp "$agents_backup" AGENTS.md
    rm -f "$agents_backup"
    die "cc-sdd failed. Run it by hand to see why:  npx -y cc-sdd@$CC_SDD_VERSION --opencode-skills --lang $lang --yes"
  fi

  if [[ "$had_agents" -eq 1 ]]; then
    local generated; generated="$(mktemp)"
    cp AGENTS.md "$generated"
    cp "$agents_backup" AGENTS.md
    if ! grep -qF "$SDD_MARK_BEGIN" AGENTS.md; then
      {
        printf '\n%s\n' "$SDD_MARK_BEGIN"
        printf '<!-- Added by `ai4dev sdd setup`. Everything above this line is yours. -->\n\n'
        cat "$generated"
        printf '\n%s\n' "$SDD_MARK_END"
      } >> AGENTS.md
      ok "your AGENTS.md was kept, and cc-sdd's guidance appended below it"
    else
      ok "your AGENTS.md was kept (cc-sdd's block was already there)"
    fi
    rm -f "$generated"
  fi
  rm -f "$agents_backup"

  local ncmd=0
  [[ "$want_commands" -eq 1 ]] && ncmd="$(sdd_write_wrappers)"

  ok "cc-sdd $CC_SDD_VERSION installed"
  info "  .opencode/skills/   the kiro-* workflows, as skills"
  info "  .kiro/settings/     the templates those workflows write from"
  [[ "$ncmd" -gt 0 ]] && info "  .opencode/command/  $ncmd slash commands, one per skill"
  printf '\n'
  info "one phase at a time, and each one is a gate:"
  info "  /kiro-spec-init \"<what to build>\"      then  /kiro-spec-requirements <feature>"
  info "  /kiro-spec-design <feature>            /kiro-spec-tasks <feature>"
  info "run them inside OpenCode, started with: ai4dev code"
  printf '\n'
  if [[ "$ncmd" -eq 0 ]]; then
    warn "while you type one of those, OpenCode will say \"No matching items\"."
    warn "Ignore it and press enter: the popup lists commands, the skills are"
    warn "resolved on submit. 'ai4dev sdd commands' adds the popup entries too."
  fi
  warn "this changed files in the repository — review and commit them deliberately"
}

# ─── mcp — connect a server, with the smallest secret that works ────────────
#
# The zero-secret path does not exist for GitHub, and it is worth knowing why.
# OpenCode's `opencode mcp auth` registers itself with the authorization server
# on the spot (RFC 7591, dynamic client registration). GitHub's remote MCP
# server does not implement it — "Incompatible auth server: does not support
# dynamic client registration" is that, and nothing you can fix in the config.
# OpenCode does accept a pre-registered `oauth.clientId` / `clientSecret`, but
# a GitHub OAuth app needs its secret to exchange the code, so that would mean
# handing the same secret to a room. Worse than a token per person.
#
# So the default is a token, and the first place we look is `gh auth token`:
# most participants are already logged in, which means no new credential is
# created at all. The token never goes into opencode.json — it lives in this
# CLI's config, mode 600, and `ai4dev code` puts it in the environment of the
# process it is about to become, exactly as it does the gateway key.
#
# --oauth is still there for a server that does support registration.
readonly GITHUB_MCP_URL="https://api.githubcopilot.com/mcp/"

github_token_from_somewhere() {
  local t=""
  if [[ -n "${GITHUB_TOKEN:-}" ]]; then printf '%s' "$GITHUB_TOKEN"; return 0; fi
  if [[ -n "${GH_TOKEN:-}" ]];     then printf '%s' "$GH_TOKEN";     return 0; fi
  if command -v gh >/dev/null 2>&1 && t="$(gh auth token 2>/dev/null)" && [[ -n "$t" ]]; then
    printf '%s' "$t"; return 0
  fi
  return 1
}

mcp_write_block() {
  # mcp_write_block <name> <json for that server>
  local name="$1" block="$2" tmp existing
  mkdir -p "$(dirname "$OPENCODE_CONFIG_FILE")"
  existing='{}'
  if [[ -f "$OPENCODE_CONFIG_FILE" ]]; then
    existing="$(jq '.' "$OPENCODE_CONFIG_FILE" 2>/dev/null)" \
      || die "$OPENCODE_CONFIG_FILE is not valid JSON — fix it, or: ai4dev code --reconfigure"
  fi
  tmp="$OPENCODE_CONFIG_FILE.tmp.$$"
  printf '%s' "$existing" \
    | jq --arg n "$name" --argjson b "$block" '.mcp[$n] = $b' > "$tmp" \
    || { rm -f "$tmp"; die "could not write $tmp"; }
  mv "$tmp" "$OPENCODE_CONFIG_FILE"
}

cmd_mcp() {
  load_config
  command -v jq >/dev/null 2>&1 || die "jq not found. brew install jq"
  local sub="${1:-}"; shift || true

  case "$sub" in
    list)
      command -v opencode >/dev/null 2>&1 || die "opencode not found"
      # The config says Bearer {env:AI4DEV_GITHUB_TOKEN}. OpenCode substitutes
      # that from ITS OWN environment, and an unset variable becomes the empty
      # string: the server then sees a bare "Bearer" and answers 400, which
      # OpenCode reports as "SSE error: Non-200 status code (400)" — an auth
      # failure wearing a transport failure's clothes. So a bare
      # `opencode mcp list` cannot work. This one can, because it exports it.
      [[ -n "${AI4DEV_GITHUB_TOKEN:-}" ]] && export AI4DEV_GITHUB_TOKEN
      exec opencode mcp list
      ;;
    remove)
      local name="${1:-}"; [[ -n "$name" ]] || die "usage: ai4dev mcp remove <name>"
      [[ -f "$OPENCODE_CONFIG_FILE" ]] || die "no OpenCode config yet"
      local tmp="$OPENCODE_CONFIG_FILE.tmp.$$"
      jq --arg n "$name" 'del(.mcp[$n]) | if (.mcp | length) == 0 then del(.mcp) else . end' \
        "$OPENCODE_CONFIG_FILE" > "$tmp" || { rm -f "$tmp"; die "could not rewrite the config"; }
      mv "$tmp" "$OPENCODE_CONFIG_FILE"
      ok "$name removed from your OpenCode config"
      info "it stops costing you context on your next session, not this one"
      ;;
    add)
      local what="${1:-}"; shift || true
      [[ "$what" == "github" ]] || die "usage: ai4dev mcp add github [--oauth]"
      local mode="token"
      [[ "${1:-}" == "--oauth" ]] && mode="oauth"
      [[ "${1:-}" == "--token" ]] && mode="token"   # accepted, it is the default

      if [[ "$mode" == "oauth" ]]; then
        mcp_write_block github "$(jq -n --arg url "$GITHUB_MCP_URL" \
          '{type:"remote", url:$url, enabled:true}')"
        ok "github added to $OPENCODE_CONFIG_FILE — no token stored"
        printf '\n'
        info "now run:  opencode mcp auth github"
        printf '\n'
        warn "against GitHub this fails with \"does not support dynamic client"
        warn "registration\". GitHub does not implement it, and no setting here"
        warn "changes that. Use: ai4dev mcp add github"
        return 0
      fi

      local token from_gh=0
      if token="$(github_token_from_somewhere)"; then
        from_gh=1
        ok "using the token you are already signed in with"
      else
        warn "no token found in GITHUB_TOKEN, GH_TOKEN or 'gh auth token'"
        info "the cheapest fix is to sign in once:  gh auth login"
        info "otherwise create a fine-grained token at"
        info "https://github.com/settings/personal-access-tokens — read-only, this"
        info "repository, a short expiry — and paste it here. It is not echoed."
        printf '  token: ' >&2
        read -rs token; printf '\n' >&2
        [[ -n "$token" ]] || die "nothing pasted"
      fi

      umask 077
      mkdir -p "$(dirname "$CONFIG_FILE")"
      touch "$CONFIG_FILE"
      # Replace any previous line rather than appending a second one.
      if grep -q '^AI4DEV_GITHUB_TOKEN=' "$CONFIG_FILE" 2>/dev/null; then
        local tmpc="$CONFIG_FILE.tmp.$$"
        grep -v '^AI4DEV_GITHUB_TOKEN=' "$CONFIG_FILE" > "$tmpc" && mv "$tmpc" "$CONFIG_FILE"
      fi
      printf 'AI4DEV_GITHUB_TOKEN=%s\n' "\"$token\"" >> "$CONFIG_FILE"
      chmod 600 "$CONFIG_FILE"

      mcp_write_block github "$(jq -n --arg url "$GITHUB_MCP_URL" \
        '{type:"remote", url:$url, enabled:true,
          headers:{Authorization:"Bearer {env:AI4DEV_GITHUB_TOKEN}"}}')"

      ok "github added, and your token is in $CONFIG_FILE (mode 600), not in the OpenCode config"
      info "ai4dev code puts it in the environment of the session it starts, and"
      info "nowhere else. A bare 'opencode' will not find it, which is the point."
      if [[ "$from_gh" -eq 1 ]]; then
        printf '\n'
        warn "that token carries every scope you gave gh. For a course repository"
        warn "that is fine; for client work, make a fine-grained one instead."
      fi
      printf '\n'
      info "check it answers:  ai4dev mcp list"
      warn "not 'opencode mcp list' on its own: the token is not in that shell's"
      warn "environment, GitHub sees an empty Bearer and answers 400. OpenCode"
      warn "shows that as \"SSE error: Non-200 status code (400)\"."
      printf '\n'
      warn "from your next OpenCode session this server's tool definitions are in"
      warn "the context of every request. Measure it before you decide to keep it."
      info "the agent can already run 'gh' in the terminal, for free. That is the"
      info "comparison worth making before you keep this."
      ;;
    *)
      die "usage: ai4dev mcp add github [--token] · ai4dev mcp list · ai4dev mcp remove <name>"
      ;;
  esac
}

usage() {
  cat <<EOF
ai4dev $AI4DEV_VERSION — the AI4Dev course CLI

  ai4dev init            clone the course repositories into ~/ai4dev
  ai4dev doctor          verify everything, fetch your key, make one real request
  ai4dev ask <prompt>    ask an alias directly, and see what the answer cost
  ai4dev code            start OpenCode against the course gateway. Refreshes
                         the model list from the gateway on every run and
                         leaves the rest of your OpenCode config alone
                         (--reconfigure to recover an unreadable one)
  ai4dev review <file>   review a file with your review prompt, from your kit
  ai4dev commit          write a commit message from the staged diff
  ai4dev costs           your spend, your remaining budget, where your traces are
  ai4dev costs --last N  the last N requests: tokens, cost, latency, which model
  ai4dev key             check that your virtual key is present and usable
  ai4dev config          show the resolved configuration
  ai4dev module N start  put the course repository at the start of module N,
                         on a branch of your own. Refuses if you have
                         uncommitted work rather than throwing it away
  ai4dev module N end    show how module N was solved, WITHOUT touching your
                         working tree. --checkout puts it side by side
  ai4dev sdd setup       install the spec-driven harness (cc-sdd) into the
                         course repository, keeping your own AGENTS.md
  ai4dev sdd commands    optional: make the /kiro-* phases show up in OpenCode's
                         slash menu. They already run without this
  ai4dev mcp add github  connect GitHub's MCP server, with the token you are
                         already signed in with where there is one. GitHub has
                         no browser flow that works here: see the notes in mcp
  ai4dev mcp list        what is connected, and whether it authenticated
  ai4dev mcp remove <n>  disconnect one, and stop paying for its definitions
  ai4dev upgrade         update the tool from the course, leaving your work alone
                         (--force to take the course's copy even when yours is newer)

ask takes:
  --model <alias>        frontier · cheap · open-hosted · reviewer · committer …
  --temp <n>             sent only if you pass it. Some aliases reject it — on
                         purpose, and the error will explain why
  --n <count>            run the same prompt this many times, 1 to 20
  --prompt-file <path>   read the prompt from a file instead of the command line

This script lives in your kit. Edit prompts/code_review.md and the behaviour of
'ai4dev review' changes in every repository you work in.
EOF
}

main() {
  case "${1:-help}" in
    init)    shift; cmd_init    "$@" ;;
    doctor)  shift; cmd_doctor  "$@" ;;
    ask)     shift; cmd_ask     "$@" ;;
    code)    shift; cmd_code    "$@" ;;
    review)  shift; cmd_review  "$@" ;;
    commit)  shift; cmd_commit  "$@" ;;
    costs)   shift; cmd_costs   "$@" ;;
    upgrade) shift; cmd_upgrade "$@" ;;
    key)     shift; cmd_key     "$@" ;;
    config)  shift; cmd_config  "$@" ;;
    module)  shift; cmd_module  "$@" ;;
    sdd)     shift; cmd_sdd     "$@" ;;
    mcp)     shift; cmd_mcp     "$@" ;;
    version|--version|-v) printf 'ai4dev %s\n' "$AI4DEV_VERSION" ;;
    help|--help|-h) usage ;;
    *) printf 'unknown command: %s\n\n' "$1"; usage; exit 1 ;;
  esac
}

main "$@"
